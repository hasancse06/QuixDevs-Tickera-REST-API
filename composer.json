{
  "name": "quixdevs/quixdevs-tickera-rest-api",
  "description": "Secure author-scoped Tickera event and ticket type REST API.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "yoast/phpunit-polyfills": "^3.1",
    "wp-coding-standards/wpcs": "^3.0",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "doctrine/instantiator": "^1.5",
    "phpstan/phpstan": "^2.1",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "php-stubs/wordpress-stubs": "^6.8 || ^7.0"
  },
  "autoload": {
    "psr-4": {
      "QuixDevs\\TickeraRestAPI\\": "includes/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "8.1.0"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs",
    "format": "phpcbf",
    "analyse": "phpstan analyse --memory-limit=512M",
    "test:release": "python3 -m unittest discover -s tests/Release -v",
    "build": "python3 tools/build-release.py"
  }
}
