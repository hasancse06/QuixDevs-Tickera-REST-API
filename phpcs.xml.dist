<?xml version="1.0"?>
<ruleset name="QuixDevs Tickera REST API">
 <description>WordPress coding standards for runtime PHP.</description>
 <file>quixdevs-tickera-rest-api.php</file><file>includes</file>
 <arg name="extensions" value="php"/><arg value="sp"/>
 <config name="testVersion" value="8.1-"/>
 <rule ref="WordPress"><exclude name="WordPress.Files.FileName"/></rule>
 <rule ref="WordPress.NamingConventions.PrefixAllGlobals"><properties><property name="prefixes" type="array"><element value="quixdevs_tickera_rest_api"/><element value="QuixDevs"/></property></properties></rule>
<rule ref="WordPress.WP.Capabilities"><properties><property name="custom_capabilities" type="array"><element value="manage_ticket_templates_cap"/></property></properties></rule>
</ruleset>
